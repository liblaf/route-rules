{
  "repository": "liblaf/route-rules",
  "fallback": "global",
  "priority": [
    "tailnet",
    "tailscale",
    "lan",
    "cn",
    "us",
    "global"
  ],
  "v2fly_url": "https://github.com/v2fly/domain-list-community/releases/latest/download/dlc.dat_plain.yml",
  "ignore_domains": ["7h15.ru1353t.1s.m4d3.by.5ukk4w.skk.moe"],
  "rulesets": [
    {
      "name": "tailnet",
      "sources": [
        {
          "name": "Tailscale:MagicDNS",
          "kind": "domain-file",
          "path": "sources/tailnet.domain.txt"
        },
        {
          "name": "Tailscale:address-ranges",
          "kind": "cidr-file",
          "path": "sources/tailnet.ipcidr.txt"
        }
      ]
    },
    {
      "name": "tailscale",
      "exclude": ["tailnet"],
      "sources": [
        {
          "name": "Tailscale:public-services",
          "kind": "domain-file",
          "path": "sources/tailscale.domain.txt"
        }
      ]
    },
    {
      "name": "lan",
      "exclude": ["tailnet", "tailscale"],
      "sources": [
        {
          "name": "SukkaW/Surge:lan-domain",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/non_ip/lan.txt"
        },
        {
          "name": "SukkaW/Surge:lan-ip",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/ip/lan.txt"
        },
        {
          "name": "v2fly/domain-list-community:private",
          "kind": "v2fly",
          "lists": ["private"]
        },
        {
          "name": "IANA:local-addresses",
          "kind": "iana-local",
          "urls": [
            "https://www.iana.org/assignments/iana-ipv4-special-registry/iana-ipv4-special-registry-1.csv",
            "https://www.iana.org/assignments/iana-ipv6-special-registry/iana-ipv6-special-registry-1.csv"
          ]
        }
      ]
    },
    {
      "name": "cn",
      "exclude": ["tailnet", "tailscale", "lan"],
      "sources": [
        {
          "name": "felixonmars/dnsmasq-china-list:accelerated-domains.china.conf",
          "kind": "dnsmasq",
          "url": "https://raw.githubusercontent.com/felixonmars/dnsmasq-china-list/master/accelerated-domains.china.conf"
        },
        {
          "name": "gaoyifan/china-operator-ip:china46.txt",
          "kind": "cidr",
          "url": "https://raw.githubusercontent.com/gaoyifan/china-operator-ip/ip-lists/china46.txt"
        },
        {
          "name": "SukkaW/Surge:apple_cn",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/non_ip/apple_cn.txt"
        },
        {
          "name": "SukkaW/Surge:direct",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/non_ip/direct.txt"
        },
        {
          "name": "SukkaW/Surge:domestic-domain",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/non_ip/domestic.txt"
        },
        {
          "name": "SukkaW/Surge:domestic-ip",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/ip/domestic.txt"
        },
        {
          "name": "SukkaW/Surge:microsoft_cdn",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/non_ip/microsoft_cdn.txt"
        },
        {
          "name": "v2fly/domain-list-community:{cn,elsevier,sciencedirect}",
          "kind": "v2fly",
          "lists": ["cn", "elsevier", "sciencedirect"]
        },
        {
          "name": "custom:cn",
          "kind": "domain-file",
          "path": "overrides/cn.domain.txt",
          "optional_if_covered": true
        }
      ]
    },
    {
      "name": "us",
      "exclude": ["tailnet", "tailscale", "lan", "cn"],
      "sources": [
        {
          "name": "v2fly/domain-list-community:{anthropic,apple,category-ai-!cn,google-gemini,openai}",
          "kind": "v2fly",
          "lists": [
            "anthropic",
            "apple",
            "category-ai-!cn",
            "google-gemini",
            "openai"
          ]
        },
        {
          "name": "custom:anthropic-supporting-services",
          "kind": "domain-file",
          "path": "sources/anthropic.domain.txt"
        },
        {
          "name": "Anthropic:api-inbound-addresses",
          "kind": "cidr-file",
          "path": "sources/anthropic.ipcidr.txt"
        },
        {
          "name": "SukkaW/Surge:ai-domain",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/non_ip/ai.txt"
        },
        {
          "name": "SukkaW/Surge:ai-ip",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/ip/ai.txt"
        },
        {
          "name": "SukkaW/Surge:apple_services-domain",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/non_ip/apple_services.txt"
        },
        {
          "name": "SukkaW/Surge:apple_services-ip",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/ip/apple_services.txt"
        }
      ]
    },
    {
      "name": "global",
      "exclude": ["tailnet", "tailscale", "lan", "cn"],
      "sources": [
        {
          "name": "v2fly/domain-list-community:geolocation-!cn",
          "kind": "v2fly",
          "lists": ["geolocation-!cn"]
        },
        {
          "name": "SukkaW/Surge:telegram-domain",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/non_ip/telegram.txt"
        },
        {
          "name": "SukkaW/Surge:telegram-ip",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/ip/telegram.txt"
        },
        {
          "name": "SukkaW/Surge:global",
          "kind": "clash",
          "url": "https://ruleset.skk.moe/Clash/non_ip/global.txt"
        }
      ]
    }
  ],
  "assertions": [
    { "domain": "ts.net", "ruleset": "tailnet", "exclusive": true },
    {
      "domain": "server.example.ts.net",
      "ruleset": "tailnet",
      "exclusive": true
    },
    { "domain": "forgejo.liblaf.me", "ruleset": "tailnet" },
    { "domain": "jellyfin.liblaf.me", "ruleset": "tailnet" },
    { "domain": "oplist.liblaf.me", "ruleset": "tailnet" },
    { "domain": "qbt.liblaf.me", "ruleset": "tailnet" },
